{
  "name": "@bambora/wallet",
  "version": "3.3.1",
  "description": "Worldline Online Checkout JavaScript API for Wallet transactions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bambora/wallet-js.git"
  },
  "author": "Worldline S.A. <support.nordics@worldline.com> (https://worldline.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bambora/wallet-js/issues"
  },
  "homepage": "https://github.com/bambora/wallet-js#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "mocha",
    "test:package": "tsx test/test-package.ts",
    "test:package:clean": "rimraf --glob ./bambora-wallet-*.tgz",
    "test:all": "npm run build && npm run test && npm run lint && npm run test:package && npm run test:package:clean",
    "start": "rimraf ./dist && rollup -c --configPlugin typescript --watch",
    "clean": "rimraf ./dist",
    "build": "npm run lint && npm run clean && rollup -c --configPlugin typescript",
    "build:production": "cross-env NODE_ENV=production npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/chai-spies": "1.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "chai-spies": "1.1.0",
    "cross-env": "10.1.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.5",
    "jsdom": "29.1.1",
    "jsdom-global": "3.0.2",
    "mocha": "11.7.5",
    "rimraf": "6.1.3",
    "rollup": "4.60.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@types/applepayjs": "14.0.9",
    "@types/googlepay": "0.7.10"
  }
}
